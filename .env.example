VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Moyasar's Payment Form publishable key (safe to expose in the browser —
# it can only create payments, nothing else). From the Moyasar dashboard's
# API keys page: pk_test_... while testing, pk_live_... in production.
# The MOYASAR_SECRET_KEY that actually verifies payments lives only in the
# verify-moyasar-payment Supabase Edge Function's secrets, never here.
VITE_MOYASAR_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Amwal needs no client-side keys at all — create-amwal-checkout and
# verify-amwal-payment (Supabase Edge Functions) hold AMWAL_SECRET_KEY /
# AMWAL_PUBLIC_KEY / AMWAL_STORE_ID as Supabase secrets, not app env vars.
